#include <stdio.h>

#define THRESHOLD 500

struct Sensor
{
    int sensorID;
    char position[10];
    int reading;
    int lineDetected;
};

int main()
{
    struct Sensor s[3];
    int i, left = 0, centre = 0, right = 0;

    printf("LINE FOLLOWING ROBOT SENSOR ANALYSIS\n");

  
    for(i = 0; i < 3; i++)
    {
        printf("\nEnter details of Sensor %d\n", i + 1);

        printf("Enter Sensor ID: ");
        scanf("%d", &s[i].sensorID);

        printf("Enter Sensor Position (Left/Centre/Right): ");
        scanf("%9s", s[i].position);

        printf("Enter Analog Reading (0-1023): ");
        scanf("%d", &s[i].reading);

     
        if(s[i].reading < 0 || s[i].reading > 1023)
        {
            printf("Invalid reading! Enter a value between 0 and 1023.\n");
            return 1;
        }

 
        if(s[i].reading < THRESHOLD)
        {
            s[i].lineDetected = 1;
            printf("Line Condition: Line Detected\n");
        }
        else
        {
            s[i].lineDetected = 0;
            printf("Line Condition: No Line Detected\n");
        }

     
        if(s[i].lineDetected == 1)
        {
            if(s[i].position[0] == 'L' ||
               s[i].position[0] == 'l')
                left = 1;

            else if(s[i].position[0] == 'C' ||
                    s[i].position[0] == 'c')
                centre = 1;

            else if(s[i].position[0] == 'R' ||
                    s[i].position[0] == 'r')
                right = 1;
        }
    }

       printf("\n----- OVERALL ROBOT POSITION -----\n");

    if(left == 1 && centre == 0 && right == 0)
        printf("Line Position: LEFT\n");

    else if(left == 0 && centre == 1 && right == 0)
        printf("Line Position: CENTRE\n");

    else if(left == 0 && centre == 0 && right == 1)
        printf("Line Position: RIGHT\n");

    else if(left == 1 || centre == 1 || right == 1)
        printf("Line Position: ON TRACK\n");

    else
        printf("Line Position: LINE NOT DETECTED\n");

    return 0;
}

